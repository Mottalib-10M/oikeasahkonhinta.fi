---
/** Guides et pages outils (fi) : un fichier de `src/content/` = une page (CONTRIBUTING-SIVUT.md). */
import ContentPage from '../../components/ContentPage.astro';
import { PAGES } from '../../lib/guides';
import type { PageDef } from '../../lib/guide-types';
export function getStaticPaths() { return PAGES.map((page) => ({ params: { slug: page.fi.slug }, props: { page } })); }
const { page } = Astro.props as { page: PageDef };
---
<ContentPage page={page} lang="fi" />
